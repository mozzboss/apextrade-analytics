{
  "name": "Trade",
  "type": "object",
  "properties": {
    "market": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "risk": {
      "type": "number"
    },
    "risk_percent": {
      "type": "number"
    },
    "size_profile": {
      "type": "string",
      "enum": ["small", "standard", "big"]
    },
    "risk_reward": {
      "type": "number"
    },
    "setup_quality": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "open",
        "win",
        "loss",
        "breakeven",
        "cancelled"
      ],
      "default": "open"
    },
    "profit_loss": {
      "type": "number",
      "default": 0
    },
    "mistakes": {
      "type": "string"
    },
    "lessons": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "session": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "open"
    },
    "screenshot_uri": {
      "type": "string"
    },
    "strategy": {
      "type": "string"
    },
    "timeframe": {
      "type": "string"
    },
    "market_condition": {
      "type": "string",
      "enum": [
        "trending",
        "ranging",
        "volatile",
        "mixed"
      ]
    },
    "entry_conditions": {
      "type": "string"
    },
    "predicted_probability": {
      "type": "number"
    },
    "expected_value": {
      "type": "number"
    },
    "execution_costs": {
      "type": "number",
      "default": 0
    },
    "prediction_outcome": {
      "type": "string",
      "enum": [
        "correct",
        "incorrect",
        "pending"
      ]
    },
    "parent_trade_id": {
      "type": "string"
    },
    "broker_provider": {
      "type": "string",
      "enum": ["paper", "oanda"]
    },
    "broker_order_id": {
      "type": "string"
    },
    "broker_trade_id": {
      "type": "string"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["paper", "live"]
    },
    "broker_user_id": {
      "type": "string"
    }
  },
  "required": [
    "market",
    "direction"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
